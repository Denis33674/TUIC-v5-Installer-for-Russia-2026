# =============================================
# .gitignore для TUIC Installer
# =============================================

# Логи
*.log
*.log.*

# Временные файлы
*.tmp
*.temp

# Скачанные архивы
*.zip
*.tar.gz
*.tgz

# Сертификаты и ключи (чтобы случайно не залить)
*.crt
*.key
*.pem

# Конфиги с паролями (если будут)
config.json
*.yaml
*.yml

# Системные файлы
.DS_Store
Thumbs.db

# Временные файлы редакторов
*.swp
*.swo
*~
.vscode/
.idea/

# Локальные данные
*.bak
*.backup

# TUIC бинарник (если скачивается)
tuic
tuic-server

# Старые версии скриптов
*.old
*.orig
